# Which chain the app targets: 4663 (Robinhood Chain mainnet) or 31337 (local fork)
NEXT_PUBLIC_CHAIN_ID=4663
# Optional dedicated RPC (recommended for production; the public RPC is rate-limited)
NEXT_PUBLIC_RPC_URL=
# WalletConnect Cloud project id (empty = injected wallets only)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# $DRFT project token address. EMPTY = every token feature is hidden.
NEXT_PUBLIC_PROJECT_TOKEN=
# Optional geoblock: comma-separated ISO-3166 alpha-2 country codes (uses Vercel's x-vercel-ip-country)
NEXT_PUBLIC_GEOBLOCK_COUNTRIES=
# Local development only: expose a "Local dev account" connector that sends unsigned txs to anvil
# (--auto-impersonate). Ignored unless NEXT_PUBLIC_CHAIN_ID=31337.
NEXT_PUBLIC_LOCAL_DEV_ACCOUNTS=0xDe1e000000000000000000000000000000000001,0xb022000000000000000000000000000000000002,0x1E2d000000000000000000000000000000000003
